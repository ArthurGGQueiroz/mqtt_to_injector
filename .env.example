# Copie para .env e preencha: cp .env.example .env

# Usuário criado com mosquitto_passwd (veja mosquitto/config/README.md)
MQTT_USER=
MQTT_PASSWORD=
# O rex-tracker-sys publica em <ecode>/telemetria/<eqId>
MQTT_TOPIC=+/telemetria/+

# AWS RDS (PostgreSQL)
DB_HOST=<ENDPOINT_RDS>
DB_PORT=5432
# Role criada por sql/criar_role_mqtt_injector.sql
DB_USER=mqtt_injector
DB_PASSWORD=
DB_NAME=irrigacao_db
DB_SSLMODE=require
